{
  "name": "tohran-led-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-sanity-effects.mjs",
    "dev": "next dev",
    "sync:effects": "node scripts/sync-sanity-effects.mjs",
    "prebuild": "node scripts/sync-sanity-effects.mjs && node scripts/copy-ruffle.mjs",
    "build": "next build && node scripts/generate-sw-assets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:avi": "node scripts/check-avi.mjs",
    "check:features": "node scripts/check-features.mjs",
    "import:animations": "node --env-file=.env.local scripts/import-dl-animations.mjs"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.7.1",
    "framer-motion": "^12.18.0",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.2",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "vercel": "^66.5.0"
  },
  "overrides": {
    "postcss": "8.5.33",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
